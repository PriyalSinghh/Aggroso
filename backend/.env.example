# Field Service Dispatch and Replanning Backend Configuration

PORT=5001
NODE_ENV=development

# Database Configuration (SQLite default for zero-setup, or PostgreSQL: postgresql://user:password@localhost:5432/aggroso)
DATABASE_URL="file:./dev.db"

# AI Configuration (Optional: system includes built-in intelligent fallback when key is not provided)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
