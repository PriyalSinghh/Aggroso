# Field Service Dispatch and Replanning System Configuration

PORT=5001
NODE_ENV=development

# SQLite is only for local development and tests.
# Production deployments must use PostgreSQL.
DATABASE_URL="file:./dev.db"

# Example production value:
# DATABASE_URL="postgresql://aggroso:aggroso@localhost:5432/aggroso"

# AI Configuration (Optional: system includes built-in intelligent fallback when key is not provided)
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
